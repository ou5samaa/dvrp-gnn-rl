{
  "horizon": {
    "day_length": 480
  },

  "client_attrs": {
    "coordinates_generation": {
      "method": "uniform",
      "bounds": [0, 100]
    },
    "demand": {
      "method": "bootstrap_empirique"
    },
    "service_time": {
      "value": 21
    },
    "tw_width": {
      "method": "mixture_2_components",
      "components": [
        {"value": 63, "weight": 0.6},
        {"value": 417, "weight": 0.4}
      ]
    },
    "tw_start": {
      "distribution": "exponential_truncated",
      "bounds": [0, 480],
      "median_target": 136
    }
  },

  "vehicle_attrs": {
    "capacity_reference_solomon": {
      "value": 200
    },
    "shift_length": 480,
    "shift_start": 0,
    "shift_end": 480
  },

  "depot_attrs": {
    "capacity": "infinite",
    "position_generation": "uniform"
  },

  "entities": {
    "n_depots": 1,
    "n_clients_active_initial": 100,
    "n_clients_reserve": 50,
    "n_vehicles_total": 12
  },

  "dynamics": {
    "dod": 0.33,
    "poisson_rate_per_step": 0.33,
    "cancel_prob_per_step": 0.05
  },

  "traffic_and_space": {
    "scaling_factor_spatial": {
      "value": 0.0625
    },
    "road_factor": {
      "value": 1.66,
      "std_observed": 1.135
    },
    "vehicle_speed_kmh": {
      "value": 25
    },
    "zone_grid": {
      "n_rows": 5,
      "n_cols": 5
    },
    "traffic_base_centrality": {
      "alpha_centrality": 1.0
    },
    "hour_multiplier": {
      "bands": [
        {"t_start": 0, "t_end": 90, "multiplier": 1.3},
        {"t_start": 90, "t_end": 330, "multiplier": 1.0},
        {"t_start": 330, "t_end": 480, "multiplier": 1.3}
      ],
      "traffic_noise_std": {
        "value": 0.05
      }
    }
  }
}
